      "seed": 389031051,
      "version": 437,
      "versionNonce": 1525477899,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1782562023478,
      "link": null,
      "locked": false,
      "text": "RateLimitFilter spliced before the\nUsernamePasswordAuthenticationFilter slot\n(anchor only, not actually in the chain) in\nSpring Security's canonical filter order, so it\nruns ahead of the real auth \n  filter, BearerTokenAuthenticationFilter\n(JWT validation), which sits after that slot.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "65c8zrM5gX9xq2deTRSvQ",
      "originalText": "RateLimitFilter spliced before the UsernamePasswordAuthenticationFilter slot (anchor only, not actually in the chain) in Spring Security's canonical filter order, so it runs ahead of the real auth \n  filter, BearerTokenAuthenticationFilter (JWT validation), which sits after that slot.",
      "autoResize": true,
      "lineHeight": 1.25
    },
